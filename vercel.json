{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": false
  },
  "redirects": [
    {
      "source": "/decor/:kind(frames|banners)/:file",
      "destination": "https://cdn.jsdelivr.net/gh/XaviersDev/FunPayTools-Site@main/decor/:kind/:file",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.funpay.tools"
        }
      ],
      "destination": "https://funpay.tools/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "funpay-extension.vercel.app"
        }
      ],
      "destination": "https://funpay.tools/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "funpay-chrome-extension.vercel.app"
        }
      ],
      "destination": "https://funpay.tools/$1",
      "permanent": true
    }
  ],
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)\\.(css|js|png|jpg|jpeg|webp|svg|ico|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
